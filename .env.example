# ==========================================
# Kream Ko - Environment Configuration
# ==========================================

# 1. Database Connection (PostgreSQL - Free tier on Neon.tech recommended)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://kreamko_owner:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/kreamko?sslmode=require"

# 2. Authentication Secret (32+ characters random string for signing JWT session tokens)
# You can generate one with: openssl rand -base64 32
AUTH_SECRET="kream-ko-super-secret-jwt-key-change-this-in-production-123456789"

# 3. Application URL (used for invite link generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. First Admin Account (automatically seeded into the database)
ADMIN_INITIAL_EMAIL="admin@kreamko.ph"
ADMIN_INITIAL_PASSWORD="KreamKoAdmin2026!"
ADMIN_INITIAL_NAME="Kream Ko Admin"

# 5. Timezone (Default: Asia/Manila)
NEXT_PUBLIC_TIMEZONE="Asia/Manila"

